{
  "manifest_version": 3,
  "name": "TO Coords",
  "description": "Свои координаты, мини-карта и файлы карт Tanki Online",
  "version": "1.4.0",
  "key": "",
  "icons": {
    "16": "img/icon/16.png",
    "32": "img/icon/32.png",
    "48": "img/icon/48.png",
    "96": "img/icon/96.png",
    "128": "img/icon/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "img/icon/16.png",
      "32": "img/icon/32.png",
      "48": "img/icon/48.png",
      "128": "img/icon/128.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.tankionline.com/*",
    "*://*.test-ru.tankionline.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.tankionline.com/*",
        "*://*.test-ru.tankionline.com/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://*.tankionline.com/*",
        "*://*.test-ru.tankionline.com/*"
      ],
      "js": [
        "scripts/tanki-self-coords.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "maps/*"
      ],
      "matches": [
        "*://*.tankionline.com/*",
        "*://*.test-ru.tankionline.com/*"
      ]
    }
  ]
}
